# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# cargo-fuzz artifacts (the fuzz crate is outside the workspace)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Coverage / profiling output
*.profraw
*.profdata
/coverage

# Editor / IDE files
.idea/
.vscode/
*.swp
*~

# OS noise
.DS_Store
Thumbs.db

# Local AV2 scratch streams (do not commit sample bitstreams)
/scratch
*.av2
*.obu
# ...but DO track the curated test fixtures.
!/tests/fixtures/*.av2

# NOTE: Cargo.lock is intentionally committed (this repo builds binaries).
